{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "@ichava/icon-browser",
    "version": "0.1.0",
    "description": "SVG Icon Management Package with React + Inertia.js Browser (Laravel Integrated)",
    "private": true,
    "type": "module",
    "scripts": {
        "// clean": "Narrow on purpose. inertia-app.js/.css are CHECKED IN and no npm script or CI job rebuilds them -- only build does. rm -rf public/* destroyed them, and a failing vite build destroyed them for nothing. Delete only what the build re-emits. See issue #26.",
        "clean": "rm -rf public/assets/js/inertia-app.js public/assets/css/inertia-app.css public/.vite 2>/dev/null || true",
        "build": "npm run clean && echo '' && echo '🔨 Building Ichava (dev)...' && NODE_ENV=development vite build --config vite.inertia.config.ts",
        "build:prod": "npm run clean && echo '' && echo '🚀 Building Ichava (production)...' && NODE_ENV=production vite build --config vite.inertia.config.ts",
        "watch": "echo '' && echo '👀 Watching Ichava for changes...' && vite build --watch --config vite.inertia.config.ts",
        "dev": "vite --config vite.inertia.config.ts",
        "test:js": "vitest run",
        "test:js:watch": "vitest",
        "typecheck:inertia": "tsc -p tsconfig.inertia.json"
    },
    "keywords": [
        "icons",
        "svg",
        "ichava",
        "react",
        "inertia",
        "tailwindcss",
        "laravel"
    ],
    "dependencies": {
        "@ichava/motion": "git+https://github.com/ichava/motion.git#v0.1.1",
        "@inertiajs/react": "^3.0",
        "@tanstack/react-virtual": "^3.14.8",
        "@untitledui/icons": "^0.0.22",
        "clsx": "^2.1.1",
        "dompurify": "^3.4.14",
        "fflate": "^0.8.3",
        "react": "^19.2.8",
        "react-aria": "^3.50.0",
        "react-aria-components": "^1.19.0",
        "react-dom": "^19.2.8",
        "tailwind-merge": "^3.4.0",
        "tailwindcss-react-aria-components": "^2.2.0",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.1.17",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^16.3.2",
        "@types/dompurify": "^3.0.5",
        "@types/node": "^24.10.1",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.2.0",
        "@vitest/coverage-v8": "^2.1.5",
        "autoprefixer": "^10.4.22",
        "jsdom": "^30.0.1",
        "postcss": "^8.5.6",
        "sass": "^1.94.2",
        "tailwindcss": "^4.1.17",
        "tailwindcss-animate": "^1.0.7",
        "typescript": "~5.9.3",
        "vite": "^7.2.4",
        "vitest": "^2.1.5"
    }
}

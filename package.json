{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "@ichava/icon-browser",
    "version": "0.1.0",
    "description": "SVG Icon Management Package with Vue.js + shadcn-vue Browser (Laravel Integrated)",
    "private": true,
    "type": "module",
    "scripts": {
        "// clean": "Narrow on purpose. ichava-react.js/.css are CHECKED IN and no npm script or CI job rebuilds them -- only build:react does. rm -rf public/* destroyed them, and a failing vite build destroyed them for nothing. Delete only what the Vue build re-emits. See issue #26.",
        "clean": "rm -rf public/assets/js/ichava.js public/assets/js/ichava.js.map public/assets/css/ichava.css public/.vite 2>/dev/null || true",
        "build": "npm run clean && echo '' && echo '\ud83d\udd28 Building Ichava (dev)...' && NODE_ENV=development vite build && npm run build:react",
        "build:prod": "npm run clean && echo '' && echo '\ud83d\ude80 Building Ichava (production)...' && NODE_ENV=production vite build && npm run build:react",
        "build:react": "vite build --config vite.react.config.ts",
        "watch": "echo '' && echo '\ud83d\udc40 Watching Ichava for changes...' && vite build --watch",
        "dev": "vite",
        "dev:inertia": "vite --config vite.inertia.config.ts",
        "build:inertia": "echo '' && echo '\ud83d\udd28 Building Ichava Inertia (dev)...' && NODE_ENV=development vite build --config vite.inertia.config.ts",
        "build:inertia:prod": "echo '' && echo '\ud83d\ude80 Building Ichava Inertia (production)...' && NODE_ENV=production vite build --config vite.inertia.config.ts",
        "preview": "vite preview",
        "test:js": "vitest run",
        "test:js:watch": "vitest",
        "typecheck:inertia": "tsc -p tsconfig.inertia.json"
    },
    "keywords": [
        "icons",
        "svg",
        "ichava",
        "vue",
        "shadcn-vue",
        "tailwindcss",
        "laravel"
    ],
    "dependencies": {
        "@headlessui/vue": "^1.7.23",
        "@ichava/motion": "git+https://github.com/ichava/motion.git#v0.1.1",
        "@ichava/react-browser": "file:../react-browser",
        "@inertiajs/react": "^3.0",
        "@react-stately/utils": "^3.12.1",
        "@tanstack/react-virtual": "^3.14.8",
        "@untitledui/icons": "^0.0.22",
        "fflate": "^0.8.3",
        "input-otp": "^1.4.2",
        "react-aria": "^3.50.0",
        "react-aria-components": "^1.19.0",
        "tailwindcss-react-aria-components": "^2.2.0",
        "tw-animate-css": "^1.4.0",
        "zustand": "^5.0.14",
        "@tailwindcss/postcss": "^4.1.17",
        "@tailwindplus/elements": "^1.0.19",
        "@types/dompurify": "^3.0.5",
        "@types/node": "^24.10.1",
        "@unovis/ts": "^1.6.2",
        "@unovis/vue": "^1.6.2",
        "@vee-validate/zod": "^4.15.1",
        "@vitejs/plugin-vue": "^6.0.1",
        "@vue/tsconfig": "^0.8.1",
        "@vueuse/core": "^14.1.0",
        "autoprefixer": "^10.4.22",
        "axios": "^1.13.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dompurify": "^3.4.14",
        "embla-carousel-vue": "^8.6.0",
        "lodash": "^4.17.21",
        "lucide-vue-next": "^0.555.0",
        "pinia": "^2.2.0",
        "postcss": "^8.5.6",
        "radix-vue": "^1.9.17",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "reka-ui": "^2.6.1",
        "tailwind-merge": "^3.4.0",
        "tailwindcss": "^4.1.17",
        "tiny-emitter": "^2.1.0",
        "typescript": "~5.9.3",
        "vaul-vue": "^0.4.1",
        "vee-validate": "^4.15.1",
        "vite": "^7.2.4",
        "vue": "^3.5.24",
        "vue-sonner": "^2.0.9",
        "vue-tsc": "^3.1.4",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@radix-icons/vue": "^1.0.0",
        "@tailwindcss/postcss": "^4.1.17",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^24.10.1",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.2.0",
        "@vitejs/plugin-vue": "^6.0.1",
        "@vitest/coverage-v8": "^2.1.5",
        "@vue/test-utils": "^2.4.6",
        "@vue/tsconfig": "^0.8.1",
        "autoprefixer": "^10.4.22",
        "jsdom": "^30.0.1",
        "postcss": "^8.5.6",
        "sass": "^1.94.2",
        "tailwindcss": "^4.1.17",
        "tailwindcss-animate": "^1.0.7",
        "typescript": "~5.9.3",
        "vite": "^7.2.4",
        "vitest": "^2.1.5",
        "vue-tsc": "^3.1.4"
    }
}
